Attribute VB_Name = "mHelpText"
'==============================================================================
' mHelpText - Inhalte der integrierten Offlinehilfe und der Technischen
' Dokumentation (Zeilenformat "Art|Text": H1, H2, P, B, N, C).
'==============================================================================
Option Explicit

Private mL As Collection

Private Sub L(ByVal kind As String, ByVal txt As String)
    mL.Add kind & "|" & txt
End Sub

Private Function Out() As Variant
    Dim a() As Variant, i As Long
    ReDim a(0 To mL.Count - 1)
    For i = 1 To mL.Count
        a(i - 1) = mL(i)
    Next
    Out = a
End Function

Public Function HelpLines() As Variant
    Set mL = New Collection
    L "H1", "In zehn Schritten zur eigenen Datei"
    L "B", "1. Die leere Masterdatei im Windows-Explorer kopieren und die Kopie sinnvoll umbenennen (z. B. „Materialverwaltung.xlsm“). Die Masterdatei selbst bleibt unverändert."
    L "B", "2. Die Kopie öffnen und, falls Excel fragt, „Inhalt aktivieren“ wählen. Ohne aktivierte Makros erscheint nur ein Hinweisblatt."
    L "B", "3. Oben links auf den Titel klicken (oder auf der Startseite „Titel der Datei festlegen“) und der Datei einen Namen geben, z. B. „Inventar Kitas“."
    L "B", "4. „Neue Tabelle“ (oder „Aus Vorlage“) wählen, Namen, Beschreibung und Symbol festlegen und „Tabelle anlegen“ klicken. Gibt es die Liste schon in Excel oder als 2ask-Befragung, macht „Liste übernehmen“ daraus eine fertige Tabelle mit Feldern und Einträgen."
    L "B", "5. Eigenschaften (Spalten) hinzufügen: Name eingeben, Art per Klick wählen (wie in Notion: Text, Nummer, Auswählen, Status, Datum, Person, Kontrollkästchen, Button, ID …) und Einstellungen wie Pflichtangabe, Hilfetext oder Auswahlmöglichkeiten festlegen. Mit „Vorschau der Eingabemaske“ das Ergebnis prüfen."
    L "B", "6. Bei Bedarf weitere Tabellen anlegen und über ein Feld vom Typ „Verknüpfung“ verbinden (z. B. Aufgabe " & ChrW(&H2192) & " Projekt). Die Gegenseite erscheint automatisch."
    L "B", "7. In die Tabelle wechseln (linke Navigation) und mit „Neuer Eintrag“ Daten erfassen. Pflichtfelder sind mit * markiert."
    L "B", "8. Über „Ansicht“ Sortierung, Gruppierung und Spalten festlegen, über „+ Ansicht“ weitere Darstellungen anlegen (Tabelle, Kalender, Board, Projektleiste) und mit „Als Ansicht speichern“ sichern."
    L "B", "9. Unter „Dashboards“ ein Dashboard anlegen und Elemente hinzufügen (Kennzahl, Diagramm, Tabelle), ohne Formeln."
    L "B", "10. Oben rechts „Speichern“ (oder Strg+S) und unter „Hilfe & Sicherung“ eine erste Sicherung erstellen. Wer möchte, schaltet unten links „Automatisch speichern“ ein; dann wird jede Änderung sofort gespeichert."
    L "N", "Tipp: Die Datei ist danach eine eigenständige Fachdatei mit Programmcode, Einstellungen und Daten. Sie braucht die Masterdatei nicht mehr."

    L "H1", "Aufbau der Oberfläche"
    L "P", "Links befindet sich die feste Navigation: oben der Titel der Datei (Klick ändert ihn), Start, Ihre Tabellen, Dashboards, Erfassungsdateien sowie unten Einrichten, Hilfe & Sicherung und Technische Dokumentation. Ganz unten der Schiebeschalter „Automatisch speichern“: grün = ein (jede Änderung wird sofort in der Datei gespeichert), grau = aus (Speichern wie gewohnt mit „Speichern“ bzw. Strg+S)."
    L "P", "Es gibt keinen getrennten Umbaumodus: Daten pflegen und Tabellen umbauen geschieht in derselben Oberfläche, wie in Notion. Die Farbe der Navigation und die Akzentfarbe wählen Sie unter „Einrichten“ per Klick auf ein Farbfeld, kräftig oder hell (ruhige Pastelltöne wie Flieder, Salbei, Himmel; dann mit dunkler Schrift). „Dokumentstil“ legt Farben, Farbstil und Schrift der ganzen Datei mit einer von 11 Vorlagen fest, oder Sie stellen sie selbst zusammen. Die Vorlage „Mainz“ ist angelehnt an das Erscheinungsbild der Stadt Mainz: Navigation in hellem Gelb, Akzent Gelb, Diagramme in Gelb und Hellgrün, Schrift Calibri."
    L "P", "Vergrößern und Verkleinern: mit dem Zoom-Regler unten rechts in Excel oder Strg + Mausrad. Die Seite baut sich passend neu auf, die Navigation behält ihre Größe. Der gewählte Zoom gilt für alle Seiten."
    L "P", "Oben rechts zeigt das Statusband, ob automatisch gespeichert wird, die letzte erfolgreiche Dateispeicherung und die letzte vorhandene Sicherung. „Ungespeicherte Änderungen“ bedeutet: Daten wurden geändert, die Datei aber noch nicht gespeichert."
    L "P", "Jede Tabelle hat oben Register für ihre Ansichten. Darunter liegen Suchfeld, Filter, Ansicht (Sortieren, Gruppieren, Spalten, Speichern), Export und die Aktionen für den markierten Eintrag. Aktive Filter erscheinen als Kacheln; ein Klick auf eine Kachel entfernt genau diesen Filter."

    L "H1", "Tägliche Arbeit"
    L "H2", "Eintrag anlegen und bearbeiten"
    L "B", "„Neuer Eintrag“ öffnet die Erfassungsmaske. Sie wird automatisch aus den Feldern der Tabelle aufgebaut; Register entstehen aus den Feldgruppen. Automatisch Berechnetes (Formeln, Rollups, Erstellt/Geändert, ID) zeigt die Maske nicht; es steht in der Tabelle; die ID erscheint im Kopf der Maske."
    L "B", "Selteneres erscheint erst auf Klick: „+“ neben einer Auswahl legt eine neue Option an, „Mehr“ unten bietet Duplizieren und Archivieren."
    L "B", "Doppelklick auf eine Zeile oder „Bearbeiten“ öffnet den markierten Eintrag. Kurze Werte können auch direkt in der Tabellenzelle geändert werden, mit denselben Prüfregeln."
    L "B", "„Speichern“ prüft alle Register. Bei einem Fehler bleibt das Fenster mit allen Eingaben offen, das betroffene Feld wird rot markiert und erklärt die Korrektur. Erst wenn alles gültig ist, wird der Eintrag vollständig gespeichert und das Fenster geschlossen."
    L "B", "„Speichern & neu“ (bei neuen Einträgen) speichert und öffnet sofort eine leere Maske. „Mehr › Duplizieren“ legt eine Kopie an (eindeutige Werte werden nicht übernommen)."
    L "B", "„Abbrechen“ verwirft nach Rückfrage die Änderungen; gespeicherte Daten bleiben unverändert."
    L "N", "Wichtig: „Speichern“ im Eintrag übernimmt die Daten in die Arbeitsmappe. Dauerhaft auf der Festplatte gesichert ist erst, wenn die Datei gespeichert wird (Statusband „Speichern“, Strg+S)."
    L "H2", "Datum und Uhrzeit"
    L "P", "Datumsfelder akzeptieren TT.MM.JJJJ (auch TT.MM.JJ). „Datum…“ öffnet einen Kalender mit Heute, Morgen und +7 Tage; bei Feldern mit Uhrzeit lassen sich Stunden und Minuten eintragen (Uhrzeiten werden ohne Sekunden angezeigt). „Übernehmen“ ändert nur das Eingabefeld; gespeichert wird mit „Speichern“."
    L "H2", "Mehrere Zellen einfügen"
    L "P", "Werte aus der Zwischenablage können in mehrere Zellen der Tabellenansicht eingefügt werden. Alle Werte werden zuerst geprüft. Ist auch nur ein Wert ungültig, wird nichts übernommen; eine Liste zeigt Zeile, Feld und Grund. Berechnete Felder, Verknüpfungen und interne IDs sind gegen Überschreiben geschützt."
    L "H2", "Sammeländerung"
    L "P", "Mehrere Zeilen markieren (Umschalt- oder Strg-Taste) und „Sammeländerung“ wählen. Nach Feld und neuem Wert zeigt eine Vorschau alle betroffenen Einträge; erst danach wird übernommen."

    L "H1", "Eigenschaften (Spalten) wie in Notion"
    L "P", "Spalten werden direkt in der Tabelle angelegt und geändert, ohne Moduswechsel."
    L "B", "Neue Spalte: das + rechts neben dem letzten Spaltenkopf. Name eingeben, Art anklicken, Speichern. Hilfetext, Register, Standardwert, Eindeutigkeit und Dublettenprüfung liegen unter „Weitere Einstellungen“. Die Spalte erscheint sofort in der Tabelle und in der Erfassungsmaske."
    L "B", "Spalte ändern: Doppelklick auf den Spaltenkopf > „Eigenschaft bearbeiten…“ (Name, Hilfetext, Pflicht, Optionen, Farben, Standardwert) oder „Neue Eigenschaft rechts davon…“. „Eigenschaft entfernen…“ prüft vorher alle Abhängigkeiten und sichert automatisch."
    L "B", "„Eigenschaften“ öffnet die Gesamtliste aller Eigenschaften der Tabelle mit Reihenfolge, Ausblenden und Vorschau der Eingabemaske."
    L "B", "Tabelle löschen: in der Tabelle „Ansicht > Tabelle … löschen…“, im Dialog „Eigenschaften“ unten „Tabelle löschen…“ oder unter Einrichten (Zeile anklicken, „Tabelle löschen…“). Abhängigkeiten werden geprüft, die Auswirkungen angezeigt, zur Bestätigung wird LÖSCHEN eingegeben; vorher wird automatisch gesichert. Ohne Datenverlust: „Aus-/Einblenden“ unter Einrichten."
    L "H2", "Verfügbare Arten"
    L "B", "Text, Nummer, Geldbetrag, Prozent, Langer Text / Notiz: mit Längen- und Wertgrenzen."
    L "B", "Auswählen, Mehrfachauswahl, Status: farbige Optionen; neue Optionen auch direkt in der Maske („+“)."
    L "B", "Mehrfachauswahl mit Grenze: unter „Weitere Einstellungen“ „Höchstens auswählbar“ eintragen (z. B. 6 Möglichkeiten, höchstens 3). Gilt in der Maske, beim Einfügen, beim Import und in Erfassungsdateien."
    L "B", "Datum, Datum mit Uhrzeit: mit Kalender und „Heute“; Regel „nicht vor“ (z. B. Ende nicht vor Beginn)."
    L "B", "Person: gepflegte Personenliste (z. B. Windows-Kennungen), Mehrfachauswahl; „+“ in der Maske legt eine neue Person an."
    L "B", "Dateien und Medien: mehrere lokale Dateien je Eintrag (nur Verweise, keine Kopien); Öffnen nach Rückfrage."
    L "B", "Kontrollkästchen: Häkchen; in der Tabelle schaltet ein Doppelklick auf die Zelle um."
    L "B", "URL, E-Mail, Telefon, Ort: mit Formatprüfung; Links und E-Mail-Programm werden nur nach bewusster Rückfrage geöffnet (die Anwendung selbst bleibt offline)."
    L "B", "Formel: eine Excel-Formel wie gewohnt, Spalten stehen in eckigen Klammern: =[Preis]*[Menge], =WENN([Frist]<HEUTE();""überfällig"";""""), =RUNDEN([Kosten]/[Stunden];2). Deutsche Funktionsnamen und Semikolon. Spalten einfügen per Klick: im Eigenschaftsdialog auf die Spaltenknöpfe, in der Formelleiste (Schaltfläche „fx“ im Tabellenkopf oder Spaltenmenü „Neue Formelspalte rechts davon…“) direkt auf eine Spalte der Tabelle. Vorschau und Prüfung erscheinen sofort beim Tippen. Rollup wertet verknüpfte Einträge aus (Anzahl, Summe, Min, Max, Durchschnitt); der frühere Assistent ohne Formel bleibt erreichbar."
    L "B", "Verknüpfung: Beziehung zu einer anderen Tabelle (n:1 oder n:m) mit automatischer Gegenseite."
    L "B", "Erstellt um, Erstellt von, Letzte Änderung um, Zuletzt bearbeitet von: werden automatisch gepflegt."
    L "B", "Button: setzt per Klick bis zu drei Felder (z. B. Status = Erledigt, Ende = heute, Bearbeiter = ich). In der Maske als Schaltfläche, in der Tabelle per Doppelklick auf die Zelle."
    L "B", "ID: fortlaufende, nie wiederverwendete Nummer mit optionalem Präfix (z. B. PRJ-12)."
    L "B", "Lokaler Pfad, Ja/Nein (auch leer): zusätzliche Arten für Ablagen und optionale Ja/Nein-Angaben."
    L "N", "Hinweis: In Erfassungsmasken mit vielen Feldern blättern Sie mit der Bildlaufleiste rechts oder mit der Tabulatortaste; das Mausrad wird von Excel-Formularen nicht unterstützt."

    L "H1", "Erfassungsdateien: Daten von vielen einsammeln"
    L "P", "Sie stellen einmal eine Excel-Liste zusammen, schicken sie an alle Beteiligten (z. B. 60 Kitas) und lesen die ausgefüllten Dateien wieder ein. Alle Antworten landen gesammelt in Ihrer Tabelle. Die erzeugte Datei ist eine normale Excel-Arbeitsmappe ohne Makros (.xlsx): Empfänger brauchen kein Programm und sehen keine Sicherheitswarnung. „So funktioniert's“ zeigt den Ablauf als Bild."
    L "H2", "Der übliche Weg: neue Einträge sammeln"
    L "B", "1. „Neue Erfassung“: Name, Zieltabelle (in diese Tabelle kommen die Antworten) und „Neue Einträge sammeln“ wählen."
    L "B", "2. Spalten zum Ausfüllen wählen. Berechnete und automatische Eigenschaften werden nicht abgefragt."
    L "B", "3. Wer füllt aus? Am besten „Aus einer festen Liste wählen“ (ein Name je Zeile) oder „Aus einer Tabelle“ (z. B. alle Einrichtungen). Dann wählen die Empfänger ihren Namen aus einer Liste; alle schreiben ihn gleich, und Sie sehen später, wer noch fehlt."
    L "B", "4. Überschrift und kurzer Hinweis. Farbstil, Schrift, Zeilenzahl und Blattschutz unter „Weitere Einstellungen“."
    L "B", "5. „Datei erzeugen…“: Es entsteht eine Datei für alle. MidPoint speichert danach die Hauptdatei, damit die Rückläufe zugeordnet werden können. Die Datei per E-Mail an alle schicken."
    L "B", "6. Ausgefüllte Dateien zurückbekommen und mit „Rücklauf einlesen…“ übernehmen (mehrere auf einmal). Die Vorschau zeigt je Datei Absender, neue, geänderte und fehlerhafte Zeilen."
    L "B", "7. „Rückmeldungen“ zeigt, wer geantwortet hat (Haken mit Datum) und wer noch fehlt („offen“). „Teilnehmende…“ ändert die Liste jederzeit."
    L "B", "8. Meldet eine Stelle ohne Datei, dass sie nichts beizutragen hat (z. B. per Mail): in den „Rückmeldungen“ auf „offen“ klicken und „Fehlanzeige eintragen“ wählen. Die Stelle zählt dann als geantwortet; ein weiterer Klick nimmt die Fehlanzeige zurück."
    L "H2", "Erweitert: vorhandene Einträge prüfen lassen"
    L "B", "Ihre bestehende Liste wird vorbelegt. Graue Spalten sind nur zur Anzeige (z. B. Inventarnummer, Bezeichnung), gelbe werden geprüft bzw. ausgefüllt. Mit „Aufteilen nach“ (z. B. Kita) entsteht je Wert eine eigene Datei mit nur diesen Einträgen. Der Rücklauf aktualisiert die Einträge über ihre versteckte ID, nur geänderte Werte."
    L "B", "In Prüfdateien stehen oben die bestehenden Einträge unter einem grauen Band, nach einem Abstand ein farbiges Band „Neue Einträge“ mit leeren Zeilen. Wurde ein Eintrag seit dem Versand bei Ihnen geändert, fragt MidPoint beim Einlesen nach."
    L "B", "Mehrere Tabellen in einer Datei: im ersten Schritt „Erweitert: weitere Tabellen“ ankreuzen oder später „Weiteres… › Weiteres Blatt hinzufügen“."
    L "H2", "Gut zu wissen"
    L "B", "Mehrfachauswahl erscheint als Ankreuzspalten: je Option eine schmale Spalte; „Ja“ wählen oder leer lassen. Hat die Eigenschaft eine Höchstzahl, nennt die Kopfzeile sie; weitere Haken nimmt Excel nicht an."
    L "B", "Doppelte Antworten: Jede Stelle wird je Datei einmal übernommen (Datei und Absender zählen). Schickt eine Stelle dieselbe Antwort zweimal, wird sie übersprungen."
    L "B", "Wurde die Hauptdatei nach dem Erzeugen ohne Speichern geschlossen, kennt sie die Erfassung nicht. Beim Einlesen bietet MidPoint dann an, die Erfassung aus der Rücklaufdatei wiederherzustellen."
    L "N", "Fehlerhafte Zeilen werden nicht übernommen; eine Datei mit Fehlern gilt erst nach vollständiger Übernahme als eingelesen. Lassen Sie die Datei korrigieren und lesen Sie sie erneut ein. Das „Rücklaufprotokoll“ zeigt, welche Dateien wann übernommen wurden."

    L "H1", "Suchen, Filtern, Sortieren, Gruppieren"
    L "B", "Suche: Begriff in das umrandete Suchfeld tippen und Enter oder „Suchen“. Gesucht wird in den sichtbaren Spalten; mehrere Wörter müssen alle vorkommen. Die Suche verändert keine gespeicherte Ansicht."
    L "B", "Filter: „Filter“ öffnet Bedingungen passend zum Feldtyp (Text enthält, Zahl zwischen, Datum im Zeitraum, Auswahl ist, leer/nicht leer, verknüpft mit …). Bedingungen lassen sich mit „und“/„oder“ kombinieren; „und“ bindet stärker."
    L "B", "„Alle Filter zurücksetzen“ im Filterdialog oder „Ansicht zurücksetzen“ stellt den gespeicherten Zustand der Ansicht wieder her."
    L "B", "Sortieren und Gruppieren über „Ansicht“. Ein Doppelklick auf eine Spaltenüberschrift öffnet das Spaltenmenü: sortieren, gruppieren, filtern, in dieser Ansicht ausblenden, Eigenschaft bearbeiten, rechts daneben einfügen oder entfernen."
    L "B", "Zeilenumbruch (Werkzeugleiste): aus = eine Zeile je Eintrag; an = lange Texte vollständig, die Zeilen wachsen mit. Wird je Ansicht gemerkt. Alle Werte stehen linksbündig."
    L "B", "Beim Öffnen der Datei werden Suche, zusätzliche Filter, Sortierung und Gruppierung der Sitzung zurückgesetzt. Gespeicherte Ansichten und die Spaltenauswahl bleiben erhalten."

    L "H1", "Ansichten"
    L "P", "Eine Tabelle kann beliebig viele gespeicherte Ansichten haben. Ansichten sind keine Datenkopien: Eine Änderung in einer Ansicht ändert den Eintrag und ist sofort in allen anderen Ansichten und Auswertungen sichtbar."
    L "B", "Tabelle: Spalten, Reihenfolge, Breite, Zusammenfassungen (Summe, Durchschnitt …). Die Bezeichnung steht immer in der ersten Spalte. Es gibt bewusst keine Fensterfixierung (keine Fixierlinien)."
    L "B", "Kalender: Monatsansicht oder Terminliste. Doppelklick auf einen Termin öffnet ihn, Doppelklick auf einen freien Tag legt dort einen Eintrag an. Mehrtägige Einträge (Enddatum unter „Ansicht bearbeiten“) erscheinen als durchgehende Leiste in einer festen Spur; überlappende Einträge liegen untereinander. Heute ist farbig umrandet. Bei mehr als vier Terminen erscheint „+ n weitere“. Einträge ohne Datum sind über „Ohne Datum“ erreichbar."
    L "B", "Board: Spalten nach Status oder Auswahlfeld mit Anzahl je Spalte. Karte anklicken und mit „Nach links/rechts“ oder „Gruppe ändern…“ verschieben; Doppelklick öffnet. Einträge ohne Gruppe stehen in einer eigenen Spalte."
    L "B", "Projektleiste (Gantt): tagesgenaue Leisten von Beginn bis Ende in Tagen, Wochen oder Monaten; die rote Linie markiert heute. „Namen auf Leisten“ zeigt die Namen dezent auf der Leiste (passt ein Name nicht, steht er rechts daneben). Klick auf eine Leiste öffnet den Eintrag. Ein Ende vor dem Beginn ist ungültig. Unvollständige Einträge sind über „Ohne vollständigen Zeitraum“ erreichbar."
    L "N", "Ansichtsregister sind nach Art farbig (Tabelle blau, Board orange, Kalender grün, Projektleiste lila). In Tabellen, Board und Kalender erfolgen Änderungen per Klick und Dialog; Ziehen mit der Maus gibt es im Dashboard („Anordnen“)."

    L "H1", "Verknüpfungen"
    L "P", "Ein Feld vom Typ „Verknüpfung“ verbindet Einträge zweier Tabellen (z. B. Aufgabe " & ChrW(&H2192) & " Projekt). Gespeichert wird über interne IDs; Namensänderungen zerstören keine Zuordnung. In der Gegentabelle erscheint automatisch ein Rückverknüpfungsfeld (z. B. „Aufgaben“ beim Projekt)."
    L "B", "„Auswählen…“ öffnet eine Suchliste mit Zusatzmerkmalen, damit gleichnamige Einträge unterscheidbar sind. „Neu anlegen…“ erstellt einen Zieleintrag, ohne den begonnenen Eintrag zu verlieren."
    L "B", "„Öffnen“ zeigt einen verknüpften Eintrag; der eigene Entwurf bleibt dabei geöffnet."
    L "B", "Archivierte verknüpfte Einträge bleiben erkennbar („archiviert“). Beim endgültigen Löschen werden nur die Zuordnungen entfernt, nie andere Einträge (kein kaskadierendes Löschen)."

    L "H1", "Berechnungen"
    L "P", "Ein „Berechnetes Feld“ wird über Auswahl aufgebaut: Funktion wählen, dann Felder oder feste Werte zuordnen. Verfügbar sind Grundrechenarten, Runden, Prozentanteil, Wenn-dann-sonst mit UND/ODER, Datumsabstände, Tage bis Frist, Überfälligkeit, Texte verbinden sowie Auswertungen verknüpfter Einträge (Anzahl, Anzahl mit Bedingung, Summe, Minimum, Maximum, Durchschnitt)."
    L "B", "Leere Werte ergeben ein leeres Ergebnis und werden nicht still als 0 gezählt. Division durch 0 erscheint als „Fehler: Division durch 0“."
    L "B", "Zirkelbezüge werden beim Einrichten erkannt und verhindert. Jede Berechnung speichert eine lesbare Beschreibung."
    L "B", "Bei verknüpften Einträgen zählt jeder Eintrag genau einmal; archivierte sind ausgenommen. Felder mit „heute“ (Tage bis Frist, Überfällig) werden beim ersten Öffnen eines Tages neu berechnet."

    L "H1", "Dashboards und Auswertungen"
    L "P", "Ein Element besteht aus Titel, Datenquelle, Kennzahl (Anzahl, ausgefüllt/leer, verschiedene Werte, Summe, Durchschnitt, Median, Minimum, Maximum, Spannweite, Anteil), optionaler Gruppierung (bei Datumsfeldern nach Monat, Quartal oder Jahr), optionalem Zeitraumfeld und Filtern. Darstellung als Kachel, Balken, Säulen, Zeitverlauf, Fläche, Anteil (Ring), Kreis, Netz (ab 3 Gruppen), Trichter, Baumdiagramm, Pareto, Rangliste, Sankey oder Tabelle. Trichter und Baumdiagramm brauchen Excel 2016/2019 oder neuer, sonst erscheint ein Balkendiagramm."
    L "B", "„Welches Diagramm passt?“ (neben „Darstellung“) zeigt alle Darstellungen als Bild mit Beispieldaten und wofür sie sich eignen. Klick wählt, Doppelklick übernimmt."
    L "B", "Sankey: zeigt Flüsse von einer Gruppierung (links, „Von“) zu einer zweiten (rechts, „Nach“), z. B. Status " & ChrW(&H2192) & " Priorität. Die Bandbreite entspricht Anzahl oder Summe; rechts höchstens 8 Gruppen, der Rest als „Weitere“."
    L "B", "Der Dashboardfilter (Zeitraum und/oder Tabellenfilter) wirkt nur auf passende Elemente; nicht betroffene Elemente sind gekennzeichnet."
    L "B", "Ein Klick auf eine Kennzahl oder Tabellenzeile bzw. „Details“ zeigt die zugrunde liegenden Datensätze."
    L "B", "Mehrfachzuordnungen: Ein Datensatz kann mehreren Gruppen angehören. Die Summe der Gruppen kann dann größer sein als die eindeutige Gesamtzahl; das Element weist darauf hin. Prozentanteile werden nie addiert."
    L "B", "Dashboards werden beim Aufruf und nach jeder Änderung neu berechnet; „Stand“ zeigt den Zeitpunkt. „Aktualisieren“ berechnet sofort neu."
    L "B", "Diagramm kopieren: Im Menü „…“ eines Elements (oder Klick auf die Karte) „Diagramm kopieren (für PowerPoint, Word)“ wählen, bei Kacheln und Tabellen entsprechend. Danach in PowerPoint oder Word mit Strg+V einfügen. Das Element kommt als Bild mit Titel, Farben und Schrift wie im Dashboard an und bleibt beim Vergrößern scharf; Menüknopf, „Details“ und Quellenhinweis werden nicht mitkopiert."
    L "B", "Vorschau: Beim Anlegen oder Bearbeiten eines Elements wird es sofort im Dashboard gezeigt (blau umrandet); danach „Übernehmen“, „Nochmals bearbeiten“ oder „Verwerfen“. Selteneres (Datumsstufe, Zeitraumfeld, Reihenfolge) liegt unter „Weitere Einstellungen“."
    L "B", "Gestaltung: Stil der Karten (Karten, Flach, Farbakzent, Kontur) und Farbstil. „Ändern…“ zeigt 11 Stile mit ihren acht Farben (Akzentfarbe, Ozean, Wald, Schiefer, Bordeaux, Erde, die Pastellstile Nordisch, Flieder, Salbei & Sand, Kontrast sowie Mainz mit Gelb und Hellgrün). Jede Auswahl wird sofort hinter dem Dialog gezeigt. Einzelne Elemente können einen eigenen Stil haben."
    L "B", "Anordnen: Das Dashboard hat ein festes Raster aus vier Spalten (hell hinterlegt). Karte ziehen und loslassen: Sie springt sofort in die nächste Spalte und Zeile („Einrasten“ ordnet bei Bedarf erneut). Breite am Rand ziehen (¼, ½, ¾ oder ganze Breite), Diagramme unten ziehen für hoch/normal. Eine Karte in eine volle Zeile gezogen verdrängt die dortige nach unten. „Fertig“ speichert genau die gezeigte Anordnung, „Abbrechen“ verwirft sie."

    L "H1", "Import und Export"
    L "B", "Import (Einrichten > Importieren): lokale XLSX- oder CSV-Datei wählen, Vorschau prüfen, Spalten zuordnen (Typvorschläge prüfen), dann „Prüfen“. Fehlerhafte Zeilen werden mit Grund gemeldet. Übernommen werden nur gültige Zeilen, und erst nach Ihrer ausdrücklichen Bestätigung. Abbrechen ändert nichts."
    L "B", "Aktualisieren statt anhängen: einen eindeutigen Schlüssel wählen (z. B. Inventarnummer). Zeilen mit vorhandenem Schlüssel aktualisieren den Eintrag."
    L "B", "Export: in jeder Ansicht „Export“, als XLSX oder CSV (UTF-8, Semikolon). Beim XLSX-Export wählbar: diese Ansicht, mehrere Ansichten der Tabelle oder mehrere Tabellen (je ein Blatt), sowie „Gestaltet“ (Titel, Filterangabe, farbige Kopfzeile, Linien, wahlweise getönte Zeilen; Farbe und Schrift wählbar) oder „Schlichte Liste“ (nur Werte). Exportiert wird, was die Ansicht zeigt, ohne interne Felder."
    L "B", "CSV-Schutz: Texte, die mit =, +, - oder @ beginnen, erhalten ein vorangestelltes Apostroph, damit andere Programme sie nicht als Formel ausführen."
    L "B", "Dashboards lassen sich als XLSX (Werte und neu erzeugte Diagramme) oder PDF exportieren. Exporte enthalten keine Makros und keine Verbindung zur Arbeitsdatei."

    L "H1", "Liste übernehmen (vorhandene Listen und 2ask-Befragungen)"
    L "P", "„Liste übernehmen“ (auf Start und unter Einrichten) macht aus einer vorhandenen Liste eine MidPoint-Tabelle, auch wenn die Liste nicht aus MidPoint stammt. Der Assistent hat fünf Schritte. Übernommen wird erst am Ende nach Ihrer Bestätigung, vorher wird automatisch gesichert. Die Quelldatei wird nur gelesen."
    L "B", "1. Art und Datei: „Befragung aus 2ask“ für einen kodierten Excel-Export mit Codeplan (in 2ask: Ergebnisse, Ergebnisse herunterladen, „Kodierte Ergebnisse/Antworten“, Format Excel und Haken bei „Codeplan hinzufügen“) oder „Sonstige Liste“ für jede andere Excel- oder CSV-Liste. Erkennt MidPoint in einer sonstigen Liste einen 2ask-Export, bietet es den passenden Modus an."
    L "B", "2. Tabelle: MidPoint sucht alle Tabellen der Datei, auch mehrere auf einem Blatt, und erkennt Titel, Kopfzeilen (auch über zwei Zeilen), Gruppen-, Summen- und Notizzeilen. Die Vorschau zeigt links, wie jede Zeile verstanden wird. Gleich aufgebaute Blätter (z. B. ein Blatt je Einrichtung) stehen zusätzlich als eine gemeinsame Tabelle zur Wahl; der Blattname wird dann ein Feld. Stimmt die Kopfzeile nicht, lässt sie sich von Hand setzen. Bei 2ask zeigt dieser Schritt die erkannten Fragen."
    L "B", "3. Rückfragen: Wo MidPoint nicht sicher ist, fragt es nach und schlägt eine Antwort vor, z. B. Kreuzspalten als eine Mehrfachauswahl, Gruppenzeilen als Feld, Summenzeilen weglassen, Monatsspalten in je einen Eintrag pro Monat umwandeln, Abkürzungen wie „erl.“ als „erledigt“, Werte, die nicht zum Typ passen („KW 14“ in einer Datumsspalte), Formelspalten und ausgeblendete Spalten. Jede Antwort wirkt sofort."
    L "B", "4. Ziel und Felder: neue Tabelle oder an eine bestehende anhängen (gleich benannte Felder werden befüllt, mit Schlüssel werden vorhandene Einträge aktualisiert). Je Feld lassen sich Name, Typ und „Übernehmen“ ändern und das Bezeichnungsfeld wählen. Bei Auswahlfeldern zeigt die Werteliste jeden Wert mit Anzahl; gleiche Bedeutungen lassen sich zusammenlegen („in Bearb.“ als „in Arbeit“). Wird ein Feld auf „Mehrfachauswahl“ umgestellt, ordnet eine Häkchenliste jeden Wert beliebig vielen Werten zu (z. B. „Kinder und Jugendliche“ zu „Kinder“ und „Jugendliche“); neue Werte lassen sich dort ergänzen. Komma, Semikolon und Zeilenumbrüche in einer Zelle trennen Werte bereits beim Lesen."
    L "B", "5. Prüfung: zeigt, wie viele Einträge übernommen werden, fehlerhafte Einträge und Hinweise zu einzelnen Werten (z. B. ein Wert, der nicht zum Typ passt und leer bleibt, oder ein Eintrag in einer Kreuzspalte, der kein Kreuz ist). Der Bericht lässt sich als CSV speichern und bleibt unter Einrichten > Letzter Importbericht verfügbar."
    L "B", "2ask: Antwortcodes werden über den Codeplan in Optionen übersetzt (Reihenfolge wie im Fragebogen). Die Einzelspalten einer Mehrfachauswahl werden ein Feld, Matrixzeilen eigene Felder, Rangfolge, Sterne, Schieberegler und Summen werden Nummern. Umkodierte fehlende Antworten (z. B. -99) bleiben leer. Von den Angaben zur Teilnahme sind Teilnahme-ID und Ende vorgewählt; Fragebögen aus dem Pretest lassen sich weglassen."
    L "N", "Nicht unterstützt: Wochenraster (Uhrzeiten in den Zeilen, Wochentage in den Spalten), Zellfarben als Bedeutung und automatische Verknüpfungen zwischen zwei übernommenen Tabellen. Ein Wochenraster bitte vorher als Liste mit einer Zeile je Termin anlegen."

    L "H1", "Archiv, Löschen und Rückgängig"
    L "B", "„Archivieren“ blendet einen Eintrag aus allen aktiven Ansichten und Auswertungen aus; Verknüpfungen bleiben. „Ansicht > Archiv anzeigen“ zeigt archivierte Einträge mit „Wiederherstellen“."
    L "B", "Endgültig löschen ist nur im Archiv möglich, mit Referenzprüfung, Bestätigungswort LÖSCHEN und angebotener Sicherung."
    L "B", "„Rückgängig“ nimmt die letzte zusammenhängende Datenänderung dieser Sitzung zurück (bis zu 20 Schritte, z. B. Speichern eines Eintrags, Einfügen, Sammeländerung, Import, Archivieren). Strukturänderungen (Felder, Tabellen) sind davon ausgenommen; dafür gibt es Sicherungen. Nach dem Schließen der Datei ist die Rücknahme nicht mehr verfügbar."
    L "N", "Hinweis: Excels eigenes Rückgängig (Strg+Z) wird durch Makros geleert. Verwenden Sie die Schaltfläche „Rückgängig“ der Anwendung."

    L "H1", "Speichern, Sicherung und Wiederherstellung"
    L "B", "Automatisch speichern (Schalter unten links): Ein = jede Änderung wird kurz danach gespeichert; aus = wie gewohnt. Die Einstellung gilt für diese Datei."
    L "B", "Speichern: Statusband „Speichern“ oder Strg+S. „Gespeichert …“ wird erst nach erfolgreichem Speichern angezeigt. Bei fehlenden Schreibrechten oder nicht erreichbarem Netzlaufwerk erscheint eine klare Fehlermeldung; die Änderungen bleiben in Excel geöffnet."
    L "B", "Manuelle Sicherung: „Jetzt sichern“. Ablage: Unterordner „<Dateiname>_Sicherungen“ neben der Datei. Dateiname: <Dateiname>_JJJJ-MM-TT_hhmmss_v<Version>.xlsm."
    L "B", "Automatische Sicherung: beim regulären Speichern (höchstens alle 60 Minuten, einstellbar) sowie vor Import, Wiederherstellung, Zurücksetzen, Entfernen von Feldern/Tabellen und Feldtypwechsel."
    L "B", "Aufbewahrung: Standardmäßig bleiben die letzten 10 Sicherungen erhalten (einstellbar). Ältere eigene Sicherungen werden entfernt, andere Dateien nie."
    L "B", "Jede Sicherung wird nach dem Schreiben geprüft. Eine fehlgeschlagene Sicherung wird gemeldet und im Statusband angezeigt; sie erscheint nie als erfolgreich."
    L "B", "Wiederherstellen: „Sicherungen & Wiederherstellen“ zeigt alle Sicherungen. Vor dem Wiederherstellen wird der aktuelle Stand gesichert. Übernommen werden Struktur, Daten, Verknüpfungen, Ansichten, Dashboards, Einstellungen und Protokoll; danach wird der Bestand geprüft. Anschließend die Datei speichern."
    L "B", "Neue leere Kopie: erzeugt eine neue Datei mit derselben Struktur ohne Einträge. Die geöffnete Datei bleibt unverändert."
    L "B", "Datei zurücksetzen: löscht alle Einträge und Verknüpfungen (Struktur und Protokoll bleiben), nur nach erfolgreicher Sicherung und dem Bestätigungswort ZURÜCKSETZEN."
    L "N", "Eine Sicherung schützt den Stand zum Sicherungszeitpunkt. Änderungen danach sind erst mit der nächsten Speicherung/Sicherung geschützt. Exporte sind keine Sicherung."

    L "H1", "Einrichtungsschutz"
    L "P", "Daten pflegen und Struktur ändern geschieht in derselben Oberfläche. Wer Strukturänderungen (Tabellen, Eigenschaften, Dashboards) absichern möchte, setzt unter Einrichten ein Schutzwort: Es wird vor der ersten Strukturänderung einer Sitzung abgefragt. Das ist ein Schutz gegen Fehlbedienung, keine Benutzerverwaltung und keine Zugriffskontrolle."

    L "H1", "Makros, Sicherheit und gemeinsame Nutzung"
    L "B", "Die Anwendung benötigt aktivierte Makros. Sicherheitseinstellungen werden von der Datei nie verändert. Üblich ist die Freigabe über einen vertrauenswürdigen Speicherort oder eine digitale Signatur durch die IT (siehe Technische Dokumentation)."
    L "B", "Alles läuft offline: keine Cloud, keine Anmeldung, keine Telemetrie, keine Downloads. Es entstehen nur bewusst erzeugte Exporte und Sicherungen."
    L "B", "Eine Person bearbeitet die Datei zur gleichen Zeit. Liegt sie auf einem Netzlaufwerk und ist bereits geöffnet, öffnet Excel sie schreibgeschützt; die Anwendung zeigt dann den Lesemodus und sperrt Bearbeitungen."
    L "B", "Blattschutz und ausgeblendete Blätter verhindern nur Fehlbedienung. Für vertrauliche Daten den Speicherort (Berechtigungen) und bei Bedarf den Office-Kennwortschutz der Datei nutzen."
    L "B", "Das Änderungsprotokoll enthält Zeitpunkt, Windows-Kennung, Art und betroffene Felder, aber keine Feldinhalte. Die Windows-Kennung ist kein sicherer Identitätsnachweis."

    L "H1", "Datenzugang"
    L "P", "Unter Einrichten > „Datenzugang“ werden die strukturierten Datenblätter (Tabellen D_T…, Konfiguration, Zuordnungen, Protokoll) schreibgeschützt eingeblendet, z. B. zur Prüfung oder für eigene Auswertungen in einer Kopie. Änderungen dort sind gesperrt, weil sie die Prüfregeln umgehen würden. Mit „Datenblätter ausblenden“ wieder schließen."
    HelpLines = Out()
End Function

Public Function TechLines() As Variant
    Set mL = New Collection
    L "H1", APP_TITLE & ": Technische Dokumentation"
    L "P", "Programmversion " & PROG_VERSION & ", Stand " & PROG_DATE & " · Formatversion " & FORMAT_VERSION & " · " & AUTHOR_NOTE & "."
    L "N", "Sicherheitsprüfung vor jedem Release (Version " & PROG_VERSION & ", Stand " & PROG_DATE & "): bestanden. Die Anwendung arbeitet vollständig lokal: kein eigener Netz- oder Internetzugriff (Links, E-Mail-Adressen, Dateien und Ordner öffnet nur ein ausdrücklicher Klick mit dem zugeordneten Windows-Programm, bei Adressen und Dateien nach Rückfrage), keine fremden Programme oder Befehle, nur Windows-Systembibliotheken (user32, gdi32, gdiplus, oleaut32), keine Änderung von Office-, Windows- oder Makroeinstellungen, kein Zugriff auf den eigenen VBA-Code zur Laufzeit. Geschrieben wird nur in den Sicherungsordner neben der Datei, in den TEMP-Ordner (Bilder) und an selbst gewählte Ziele; Quelldateien für Import und „Liste übernehmen“ werden nur gelesen. Hinweis: Protokoll und Einträge speichern die Windows-Kennung; Fachdaten können personenbezogen sein. Der vollständige Bericht liegt im Lieferpaket im Ordner „IT und Datenschutz“."
    L "H2", "Zweck und Umfang"
    L "P", "Offline nutzbare Excel-/VBA-Anwendung, mit der Personen ohne Programmierkenntnisse eigene strukturierte Datenbankanwendungen zusammenstellen: frei definierbare Tabellen und Felder, Verknüpfungen (1:n, n:m), mehrere gespeicherte Ansichten (Tabelle, Kalender, Board, Projektleiste), Berechnungen, Dashboards, Import/Export, Sicherung und Änderungsprotokoll. Fachlich neutral; keine Fachstruktur ist fest einprogrammiert."
    L "H2", "Voraussetzungen und Betrieb"
    L "B", "Microsoft Excel 365 Desktop unter Windows, 32 oder 64 Bit (Declare-Anweisungen mit PtrSafe/LongPtr). Dateiformat XLSM. Keine Add-ins, keine zusätzlichen Bibliotheken, keine ActiveX-Steuerelemente, kein Zugriff auf das VBA-Projektobjektmodell zur Laufzeit."
    L "B", "Genutzte Systembestandteile: MSForms (UserForms), user32/gdi32 (Andocken der Navigation, DPI), gdiplus/oleaut32 (Zeichnen der Navigationsform), Office-CommandBars (temporäre Kontextmenüs, werden nicht dauerhaft gespeichert). Kein Scripting.Dictionary/FileSystemObject (eigene Klasse cMap, VBA-Dateibefehle)."
    L "B", "Netzwerk: Die Anwendung baut keine Verbindungen auf. Dateizugriffe nur auf die Arbeitsdatei, den Sicherungsordner, gewählte Import-/Exportdateien und bewusst geöffnete lokale Pfade."
    L "B", "Makrofreigabe: Datei an einem vertrauenswürdigen Speicherort ablegen oder das VBA-Projekt durch die IT mit einem Codesignaturzertifikat signieren und das Zertifikat per Richtlinie als vertrauenswürdigen Herausgeber verteilen. Die Anwendung ändert keine Sicherheitseinstellungen. Ohne Makros zeigt das Blatt „Hinweis“ eine statische Erklärung."
    L "H2", "Architektur (Module)"
    L "B", "mStart, ThisWorkbook: Start/Schließen, Ereignisse, Lesemodus, Formatprüfung, Integritätsprüfung, Hinweisblatt vor dem Speichern."
    L "B", "mApp: ruhige Ausführung (ScreenUpdating/Events/Berechnung werden erfasst und, auch im Fehlerpfad, wiederhergestellt), zentrale Fehlergrenze, Modus, Lese-/Schreibstatus."
    L "B", "mCfg: Konfiguration (Tabellen, Felder, Optionen, Ansichten, Dashboards, Systemwerte) mit Puffer. mData: Datenzugriff, Zuordnungen, Transaktionen und Rückgängig. mValid: gemeinsame Prüfregeln aller Schreibwege. mFmt: deutsche Darstellung."
    L "B", "mCalc: Berechnungsbaukasten (eigener Interpreter, Abhängigkeiten, Zirkelbezugsprüfung, gezielte Neuberechnung). mQuery: Suche, Filter, Sortierung, Gruppierung."
    L "B", "mNav, frmNav, mRender: Navigation (als Kindfenster im Arbeitsmappenfenster verankert, kein Fensterfixieren), Seitenaufbau, Schaltflächen, Filterkacheln, Kontextmenüs. mViewTable, mViewCal, mViewBoard, mViewGantt: Darstellungen. mDash: Auswertungen und Dashboards. mPages: Start, Einrichten, Suche, Hilfe, Technik."
    L "B", "Schneller Seitenwechsel: Jede Seite ist ein eigenes Blatt. mNav merkt sich je Blatt den Stand beim letzten Aufbau (Daten- und Strukturstand, Ansichtszustand, Fensterbreite, Datum, Lesemodus). Ist er unverändert, wird die Seite nur eingeblendet und das Statusband aktualisiert (mNav.TryReuse). Schaltflächenbreiten werden je Beschriftung einmal gemessen, gleichfarbige Zellen gemeinsam formatiert, Bezeichnungen verknüpfter Einträge zwischengespeichert."
    L "B", "mStruct: Strukturänderungen, Abhängigkeitsprüfung, Typwechsel, Duplizieren, Vorlagen. mIO: Import/Export. mBackup: Speichern, Sicherung, Wiederherstellung, leere Kopie, Zurücksetzen. mLog: Protokoll. mCodeCat: Codekatalog und Codeexport. mCmd: alle Bedienbefehle mit Fehlergrenze. mBuild: Build-, Vorlagen- und Demodaten (nur Entwicklung)."
    L "B", "mListImport (seit 1.7.0): Liste übernehmen. Liest die Quelle schreibgeschützt (Werte, Formeln, verbundene Zellen, ausgeblendete Spalten, Zahlenformate, Excel-Tabellen), findet Tabellen, deutet Kopf-, Gruppen- und Summenzeilen, schlägt je Spalte einen Typ vor, erzeugt Rückfragen mit Vorschlag und baut daraus einen Importplan, den mIO.CheckImport und mIO.ExecuteImport prüfen und übernehmen. 2ask-Exporte werden über das Blatt „code_plan“ gedeutet."
    L "B", "Formulare: frmRecord (dynamische Maske), frmPicker (Verknüpfungsauswahl), frmDate (Kalender), frmFilter, frmColumns, frmFormula, frmField, frmTableEditor, frmImport, frmListImport (Assistent „Liste übernehmen“), frmProps (allgemeiner Dialog), frmMsg (Meldungen), frmCode (Codeansicht), frmNav. Alle Steuerelemente entstehen zur Laufzeit; es gibt keine binären Formularressourcen."
    L "B", "Klassen: cMap (Schlüssel/Wert), cField (Felddefinition), cTableData (Arrayabbild einer Tabelle), cViewState (Sitzungszustand einer Ansicht), cEvt (Ereignisweiterleitung dynamischer Steuerelemente), cLiSheet, cLiTab, cLiCol, cLiQ (gelesenes Blatt, gefundene Tabelle, geplantes Feld und Rückfrage der Listenübernahme)."
    L "H2", "Datenmodell"
    L "B", "_Tabellen: ID (T0001), Name, Beschreibung, Symbol, Bezeichnungsfeld, Reihenfolge, Status, Dublettenfelder, Erstellt, Blatt."
    L "B", "_Felder: ID (F0001), Tabelle, Name, Typ, Hilfetext, Pflicht, Standard, Reihenfolge, Sichtbar, Gruppe, Eindeutig, MaxLaenge, Dezimalstellen, Minimum, Maximum, LeerErlaubt, Zieltabelle, Mehrfach, Gegenfeld, Formel, Beschreibung, Ergebnistyp, NichtVor, Status, Erstellt."
    L "B", "_Optionen: ID (O0001), Feld, Name, Farbe, Reihenfolge, Aktiv, Abgeschlossen. Einfach-/Mehrfachauswahl und Status speichern Options-IDs (Mehrfach: „O0001;O0004“); Umbenennen ändert keine Daten."
    L "B", "Datenblätter D_T0001 …: je Fachtabelle ein ListObject mit Systemspalten _ID (R0000001, dateiweit eindeutig), _Erstellt, _Geaendert, _Benutzer, _Archiviert und je Feld eine Spalte mit der Feld-ID als Überschrift."
    L "B", "_Zuordnungen: Feld, Von, Nach, Erstellt; Verknüpfungen ausschließlich über IDs. Rückverknüpfungsfelder (Typ BACKLINK) speichern nichts selbst, sondern lesen dieselben Zuordnungen in Gegenrichtung."
    L "B", "_Ansichten: ID (V0001), Tabelle, Name, Typ, Reihenfolge, Spalten („F0001:220;F0003:90“), Filter, Sortierung („F0003:A“), Gruppierung, Optionen (z. B. datum=F0005;ende=F0006). _Dashboards/_Elemente: Dashboard- und Elementdefinitionen. _Protokoll: Änderungsprotokoll. _System: Versionen, Zähler, Einstellungen. _Listen: Hilfslisten für Zell-Auswahllisten. _Vorlagen: konfigurationsbasierte Starter. _Code: Codekatalog. _Importbericht: letzter Fehlerbericht."
    L "B", "Filterformat: „Verknüpfung|FeldID|Operator|Wert1|Wert2“ je Bedingung, durch Semikolon getrennt; Werte maskiert, Zahlen/Daten sprachunabhängig (Punkt bzw. JJJJ-MM-TT)."
    L "B", "Formelformat: „FUNKTION|Argument|…“ mit Argumenten F:FeldID, N:Zahl, T:Text, D:Datum, B:Ja/Nein, O:OptionID, K:Schlüsselwort. Ausgewertet werden die Funktionen RECHNEN, RUNDEN, ANTEIL, WENN, PRUEFEN, DATDIFF, TAGEBIS, UEBERFAELLIG, DATPLUS, TEXT und ROLLUP. Excel-Formeln (seit 1.3.0): „XL|=RUNDEN({F0003}*{F0004};2)“ mit Feld-IDs in { }. mCalc übersetzt die deutsche Formel einmal über FormulaLocal in die interne Form, schreibt die Spaltenwerte aller Einträge in Hilfsspalten des ausgeblendeten Blattes _Rechnen, füllt die Formel daneben, berechnet nur diesen Bereich und liest das Ergebnis in einem Zug (mCalc.XlEvalRows). Gesperrt: Bezüge auf Blätter/Dateien/Zellen, WEBSERVICE, FILTERXML, RTD, CALL, REGISTER.ID, IMAGE, HYPERLINK, INDIRECT, OFFSET, INFO, CELL. Texte werden immer als Text übergeben (nie ausgeführt); Daten, die mit = + - @ beginnen, werden beim Schreiben in Blätter maskiert (CellText). Keine Ausführung von Nutzereingaben als VBA."
    L "H2", "Eigenschaftsarten (Notion-ähnlich)"
    L "P", "Die Spalte „Typ“ in _Felder speichert die Art (z. B. KONTROLL, PERSON, URL, AUTOID). Jede Art beruht auf einem Grundtyp (mConst.BaseTypeOf), der Speicherung, Filter, Sortierung und Auswertung bestimmt; dadurch funktionieren alle Ansichten und Dashboards ohne Sonderlogik."
    L "B", "KONTROLL: Ja/Nein ohne Leerwert; PERSON: Mehrfachauswahl (Personenliste als Optionen); DATEIEN: Pfadliste „Pfad1|Pfad2“; URL, EMAIL, TELEFON, ORT: Text mit Formatprüfung (mValid.KindFormatOk); ROLLUP: Berechnung mit Funktion ROLLUP."
    L "B", "Automatisch gepflegt (nicht editierbar, mValid lehnt manuelle Werte ab): ERSTELLT_UM/_VON und GEAENDERT_UM/_VON aus den Systemspalten; AUTOID mit Präfix im Feld „Standard“ und Zähler „IDZaehler_<FeldID>“ in _System (Nummern werden nie wiederverwendet)."
    L "B", "BUTTON: Feld „Formel“ = „AKTION|F:FeldID|Wert|F:FeldID|Wert …“ (Werte maskiert; Schlüsselwörter heute, jetzt, ich, leer, umschalten). Ausführung über mForms.RunButton mit derselben Prüfung, Transaktion, Protokollierung und Rücknahme wie jede andere Änderung."
    L "B", "Seit 1.2.0 kein getrennter Einrichtungsmodus (mApp.IsSetupMode = schreibbar; RequireSetup fragt nur ein gesetztes Schutzwort einmal je Sitzung ab). Spaltenkopf-Doppelklick öffnet ein temporäres Kontextmenü (sortieren, gruppieren, filtern, ausblenden, Eigenschaft bearbeiten/einfügen/entfernen); „+“ legt neue Spalten an. Ohne Fensterfixierung und ohne Seitenumbruchlinien."
    L "B", "Eintragsmaske (frmRecord.ShowInForm): Formeln, Rollups und automatische Arten werden nicht angezeigt; Buttons erst bei gespeicherten Einträgen. Fehler an ausgeblendeten Eigenschaften erscheinen im Fuß der Maske."
    L "B", "Automatisch speichern: _System „AutoSpeichern“ (Ja/Nein). mApp.MarkDirty/MarkCfgDirty planen per Application.OnTime (1 s) mBackup.AutoSaveTick; solange ein Dialog offen ist oder eine Transaktion läuft, wird neu geplant. Gespeichert wird über ControlledSave; danach wird die aktuelle Seite ohne Neuaufbau wieder gezeigt."
    L "B", "Navigation: Titel/Untertitel aus _System (AppName, Untertitel, TitelFestgelegt); Navigations- und Akzentfarbe als Farbfelder auf „Einrichten“ (mCmd.Cmd_Swatch). Die Aktivmarkierung und der Schiebeschalter werden per GDI+ gezeichnet (mGdi.NavPicture, 6-fache Abtastung, Viertelkreis-Übergänge, Bild rechts breiter als sichtbar gegen Kantenartefakte). Höhe = sichtbare Höhe des Fensters (UsableHeight, ohne Excels untere Leiste); bei wenig Höhe wird stufenweise verdichtet, danach eigener Bildlauf mit Pfeilen. Das Ein-/Ausklappen des Menübands meldet Excel nicht; die Navigation prüft ihre Höhe daher bei Mausbewegung, Zellauswahl, Fensteraktivierung und Seitenaufbau (bewusst ohne Application.OnTime, damit Excel die Datei nach dem Schließen nie erneut öffnet)."
    L "B", "Seitenwechsel bauen die Navigation nicht neu auf, sondern setzen nur die Markierung um (frmNav.Update); neu aufgebaut wird nur bei geänderten Einträgen, Titel oder Farben, dabei ohne Zwischenzeichnen (WM_SETREDRAW). Gezeichnet werden nur die Streifen mit Rundungen mehrfach abgetastet. Symbol und Beschriftung stehen exakt auf der Mitte der Markierung (gemessene Zeilenhöhe). Helle Navigationsfarben schalten die Schrift auf dunkel (IsLightColor, CNavText/CNavStrong); helle Akzentfarben werden für Schrift abgedunkelt (CAccent) und für Flächen hell verwendet (CAccentFill, COnAccent)."
    L "B", "Dashboards: Stil und Palette je Dashboard in _System (DashStil_<ID>, DashPalette_<ID>), eigene Palette je Element in _Elemente.Optionen (pal=…), Höhe (hoch=1). „Anordnen“ zeichnet Rasterspalten (gesperrt) und Platzhalterkarten ohne Makro (nicht gesperrt, daher ziehbar). Raster je Element in _Elemente.Optionen (gx = Spalte 0 bis 3, gy = Zeile) und Groesse (1 bis 4 Spalten); mDash.LayoutGrid ordnet überschneidungsfrei an (gezogene Karten zuerst, verdrängte rücken nach rechts bzw. unten, leere Zeilen entfallen). Einrasten bei Zellauswahl oder „Einrasten“ (SnapArrangement, nur im Speicher), „Fertig“ speichert (ApplyArrangement). Vorschau beim Anlegen: Element wird gespeichert, markiert (gHighlight) gezeigt und erst nach „Übernehmen“ behalten; „Verwerfen“ löscht es wieder."

    L "H2", "Erfassungsdateien (mCapture)"
    L "B", "_Erfassungen: ID (C0001), Name, Tabelle, Felder (FeldIDs zum Ausfüllen), Modus (Liste/Formular), Titel, Einleitung, Zeilen, Absender, AbsenderFeld, Schutz, Erstellt, Version, Optionen. Optionen (Schlüssel=Wert): art=pruefen, anzeige=FeldIDs (grau), ansicht=ViewID (Einträge), teilen=FeldID (je Empfänger eine Datei), neuzeilen=n, eltern=ErfassungID (weiteres Blatt derselben Datei), abslabel, absbreite, farbe, anleitung. _Ruecklauf: DateiID, Datei, Erfassung, Absender, Zeilen, Importiert, Benutzer, Empfaenger. Versand je Datei in _System „Versand_<ID>“ (Zeitpunkt, Empfänger, DateiID) für die Rücklauf-Übersicht."
    L "B", "Erzeugte Datei (.xlsx, ohne Makros): ein Blatt je Festlegung (Hauptblatt plus weitere Blätter), sehr verstecktes Blatt „Listen“ (Auswahlwerte, Namen L_<FeldID>, L_JA) und sehr verstecktes Blatt „_Info“ (Kennung, ErfassungID, DateiID, DatenbankID, Empfaenger, Aufbau=2; je Blatt eine Zeile „Blatt“ mit Name, ErfassungID, TabelleID, erster/letzter Datenzeile, „Spalten“ mit ID- und Stand-Spalte, sowie je Spalte „Spalte|Art|FeldID|OptionID|Spalte“; Art ANZ = grau, FELD = gelb, OPT = Ankreuzspalte einer Mehrfachauswahl, ID/STAND versteckt). Mehrfachauswahl bis 30 Optionen als Ankreuzspalten (senkrechter Titel, Datenüberprüfung „Ja“), darüber als Text „A; B“."
    L "B", "Einlesen: Datei schreibgeschützt mit deaktivierten Makros öffnen, Kennung, Datenbank und doppeltes Einlesen prüfen, je Blatt die Zeilen lesen. Zeilen mit ID aktualisieren den Eintrag (nur geänderte Werte; Konflikt, wenn _Geaendert jünger als der Stand beim Versand), Zeilen ohne ID legen neue Einträge an (Aufteilungsfeld wird auf den Empfänger gesetzt). Prüfung über mValid.ParseCell/ParseInput und ValidateRecord (dieselben Regeln wie im Formular), Verknüpfungen über eindeutige Bezeichnungen, Übernahme in einer Transaktion, DateiID in _Ruecklauf vermerken. Dateien des Aufbaus 1 (Version 1.1) werden weiterhin gelesen."

    L "H2", "Speicherwege, Transaktionen, Rückgängig"
    L "P", "Alle Schreibwege (Formular, Zelle, Einfügen, Sammeländerung, Board, Import, Rücknahme) nutzen mValid und mData. Eine Transaktion zeichnet Zeilen- und Zuordnungsoperationen mit Vorher-Stand auf; schlägt ein Teil fehl, werden alle Operationen in umgekehrter Reihenfolge zurückgenommen. Abhängige Berechnungen laufen innerhalb derselben Transaktion (betroffene Datensätze und über Rollups verknüpfte Datensätze; bei Massenänderungen spaltenweise Neuberechnung). Nach Abschluss wird die Transaktion als Rückgängig-Schritt der Sitzung abgelegt (max. 20)."
    L "H2", "Oberfläche, Ereignisse, Fehler"
    L "B", "Ein Oberflächenblatt je Seitentyp (Start, Tabelle, Kalender, Board, Gantt, Dashboard, Einrichten, Hilfe, Technik, Suche); jeweils nur das aktive ist sichtbar. Seiten werden bei jedem Aufruf frisch aufgebaut; Sitzungsfilter liegen in cViewState."
    L "B", "Arbeitsmappenereignisse (SheetChange, SelectionChange, BeforeDoubleClick, WindowResize, BeforeSave, BeforeClose) leiten an die Ansichtsmodule; Wiedereintritt wird verhindert."
    L "B", "Alle Bedienbefehle laufen über mCmd mit Fehlergrenze: begonnene Transaktionen werden zurückgenommen, Excel-Zustände wiederhergestellt, eine verständliche Meldung erscheint; der VBA-Editor wird nicht geöffnet."
    L "B", "Einstellungen anderer Arbeitsmappen werden nicht verändert: Gitternetz, Köpfe und Register werden nur für das Fenster dieser Datei ausgeblendet; Menüband und Bearbeitungsleiste bleiben unverändert."
    L "H2", "Sicherung, Wiederherstellung, Migration"
    L "B", "Sicherung per SaveCopyAs in „<Datei>_Sicherungen“, Prüfung auf Größe und ZIP-Signatur, Aufbewahrung der letzten N eigenen Sicherungen (Standard 10)."
    L "B", "Wiederherstellung: Sicherung schreibgeschützt mit deaktivierten Makros öffnen, Formatversion prüfen, Konfigurations- und Datenblätter übernehmen, Integrität prüfen, neu berechnen. Die geöffnete Datei wird nicht durch sich selbst ersetzt."
    L "B", "Migration: _System enthält Formatversion und Programmversion. Beim Öffnen prüft mStart die Formatversion; künftige Versionen ergänzen fehlende Spalten/Blätter per Migrationsroutine, ohne Daten neu erfassen zu müssen. Programmupdate: Code der neuen Masterversion in eine Kopie der Fachdatei übernehmen (build.ps1 -Update „Pfad“ erzeugt „…_aktualisiert.xlsm“; beim ersten Öffnen ergänzt die Migration fehlende Spalten, z. B. von Format 2 auf 3)."
    L "H2", "Leistung und Grenzen"
    L "B", "Prüfprofil: 10 Tabellen, bis 50 Felder je Tabelle, 20.000 Datensätze (eine Tabelle mit 10.000) und 40.000 Zuordnungen. Gemessene Werte stehen im mitgelieferten Prüfbericht."
    L "B", "Tabellenansicht zeigt seitenweise 100 Einträge (einstellbar); Kalender bis 4 Termine je Tag plus „weitere“; Board bis 40 Karten je Spalte; Projektleiste bis 300 Zeilen je Zeitraum. Alle Daten bleiben über Filter, Seiten und Listen erreichbar."
    L "B", "Mausrad scrollt in Formularen nicht innerhalb von Registerseiten (Grenze von MSForms); Bildlaufleiste und Tabulator/Enter funktionieren. Drag-and-drop nur beim Anordnen von Dashboards."
    L "B", "Keine gleichzeitige Bearbeitung durch mehrere Personen; Excel-Dateisperre auf Netzlaufwerken ermöglicht nacheinander arbeiten (zweite Person: Lesemodus)."
    L "H2", "Build und Reproduzierbarkeit"
    L "P", "Quellen liegen als Textdateien vor (src\modules, src\classes, src\forms, src\ThisWorkbook.cls). Das PowerShell-Skript build\build.ps1 erzeugt mit einer lokalen Excel-Installation die Master- und Demodatei: neue Mappe, Module/Klassen importieren, Formulare anlegen und Code einfügen, mBuild.Build_Init (Blätter, Konfiguration, Vorlagen, Hilfe, Codekatalog), speichern. Voraussetzung nur auf dem Entwicklungsrechner: „Zugriff auf das VBA-Projektobjektmodell vertrauen“. Anwenderrechner benötigen diese Einstellung nicht."
    L "B", "Prüfskripte: build\lint.ps1 (statische Prüfung: reservierte Namen, Doppeldeklarationen, Zeichensatz Windows-1252, verschmolzene Zeilen), build\selftest.ps1 (automatisierte Abnahmeprüfungen mit mSelfTest in einer Demokopie inkl. Sicherung/Wiederherstellung und Speichern/Wiederöffnen), build\perf.ps1 (Lasttestdatei bauen und Laufzeiten messen). mSelfTest läuft nur in Demokopien (Sperre über Systemwert „Demo“)."
    L "H2", "Datenschutz"
    L "P", "Alle Daten liegen ausschließlich in der Datei bzw. in bewusst erzeugten Exporten und Sicherungen. Das Protokoll speichert keine Feldinhalte. Die Anwendung bietet keine eigene Verschlüsselung; Vertraulichkeit über Ablageort/Berechtigungen und gegebenenfalls den Office-Dateikennwortschutz."
    TechLines = Out()
End Function
